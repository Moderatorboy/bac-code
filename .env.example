# my.telegram.org -> API development tools se milega
API_ID=1234567
API_HASH=your_api_hash

# @BotFather se
BOT_TOKEN=123456:ABC-your-bot-token

# Random lamba string (openssl rand -hex 32)
SIGN_SECRET=change_me_to_a_long_random_string

# Tumhari website ka origin (CORS)
ALLOWED_ORIGIN=https://yourwebsite.com

# Public URL jahan ye server chalega (signed link banane ke liye)
PUBLIC_BASE_URL=https://stream.yourwebsite.com

# Signed link kitne seconds valid rahe
LINK_TTL=21600

# Tumhara Telegram user ID (@userinfobot se milega). Kai ho to comma se alag karo
ADMIN_IDS=123456789

# Private channel ID jahan videos store hongi
CHANNEL_ID=-1001234567890

# Telegram usernames (bina @ ke). Frontend ke buttons inhi par jayenge
TG_CONTACT_USERNAME=your_contact_username
TG_SOCIALS_USERNAME=your_channel_username
TG_BOT_USERNAME=your_b2gpt_bot_username

# Batches ki JSON file ka naam (main.py ke folder mein). Na do to batches.json
BATCHES_FILE=batches.json

# Kai batch files ek folder mein rakhni ho to (default: batches). Us folder ki saari .json files load hongi
BATCHES_DIR=batches

# Extra bots (optional, 5 tak). Ek bot par load badhe to agla bot use hota hai.
# Sabhi bots ko un saare channels mein add karo jahan videos/sheets hain.
#BOT_TOKEN_2=
#BOT_TOKEN_3=
#BOT_TOKEN_4=
#BOT_TOKEN_5=
# Ek bot par itni streams ek saath, phir agle bot par (default 5)
MAX_STREAMS_PER_BOT=5
